# Your app's domain (point its DNS A record at this server first)
PUBLIC_DOMAIN=pinjaman.example.com

# First admin login (only used the very first time the app starts)
ADMIN_USER=admin
ADMIN_PASSWORD=change-this-to-something-long

# Contact email for web push (required by browsers, not shown to borrowers)
VAPID_EMAIL=you@example.com

PORT=3000
